# Base packages these dotfiles rely on. Install with `make packages`.
# To capture everything on this machine instead:
#   brew bundle dump --force --describe --file packages/Brewfile

brew "git"
brew "vim"

# Used by the VS Code settings and the powerlevel10k prompt
cask "font-hack-nerd-font"

# Shell tools that the zsh plugins in .zshrc build on
brew "fzf"        # fuzzy finder: Ctrl-R history, Ctrl-T files, fzf-tab completion
brew "zoxide"     # z <part of a folder name> jumps to it
brew "gh"         # GitHub CLI
brew "uv"         # Python versions, environments and tools

# Reading and writing in the terminal
brew "bat"        # cat with syntax highlighting
brew "glow"       # renders Markdown
brew "marp-cli"   # slide decks from Markdown
